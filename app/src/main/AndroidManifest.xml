<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Ubicación -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Notificaciones (Android 13+, API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Micrófono para comando de voz (SpeechRecognizer) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Internet para descargar tiles del mapa (OSMDroid) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />        <!-- Foreground Service para Modo Susurro en background (Android 9+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Foreground Service para Android Auto (CarAppService) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Para solicitar exención de optimización de batería -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Para recibir el evento de geofence aunque la app esté cerrada,
         Play Services usa un broadcast interno; no requiere permiso extra. -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ecos"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Ecos">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Modo Susurro Foreground Service -->
        <service
            android:name=".DrivingModeService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Geofence broadcast receiver (Play Services lo invoca al cruzar el radio) -->
        <receiver
            android:name=".GeofenceBroadcastReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="mx.ssauroncorp.ecos.ACTION_GEOFENCE" />
            </intent-filter>
        </receiver>

        <!-- Android Auto — Car App Library
             Servicio que muestra la lista de recordatorios en el auto -->
        <service
            android:name=".EcosCarService"
            android:exported="true"
            android:foregroundServiceType="connectedDevice"
            android:label="@string/app_name"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
            </intent-filter>
            <meta-data
                android:name="androidx.car.app.minCarApiLevel"
                android:value="1" />
            <meta-data
                android:name="androidx.car.app"
                android:resource="@xml/car_service_config" />
        </service>

    </application>

</manifest>
